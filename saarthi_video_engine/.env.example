# Copy this file to .env and paste your key locally. Do not commit .env.
ELEVENLABS_API_KEY=

# Optional. Leave empty so scribe_v2 detects the language.
# Set an ISO-639-1 or ISO-639-3 code only for a single-language lesson.
ELEVENLABS_LANGUAGE_CODE=

# Optional override. The supported general model is scribe_v2.
ELEVENLABS_STT_MODEL=scribe_v2

# Google Gemini. Paste the key locally. Never commit .env and never paste the key into chat.
GEMINI_API_KEY=
