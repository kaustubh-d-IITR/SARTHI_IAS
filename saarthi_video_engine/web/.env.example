# Leave this empty during local development. Vite proxies /api to the FastAPI server.
# On Vercel, leave it empty too: vercel.json rewrites /api/* to the Render API, so the
# session cookie stays first-party. Set it only if the frontend must call the API origin
# directly (then the API needs STUDIO_COOKIE_SAMESITE=none and this origin in STUDIO_CORS_ORIGINS).
# Do not put speech, Gemini, storage, or other secret keys in frontend environment variables.
VITE_API_BASE_URL=
