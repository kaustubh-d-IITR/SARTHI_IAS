# Production settings for the Render API service and worker. A template only: enter real values
# in the Render dashboard (render.yaml marks them sync: false). Never commit a filled-in copy.

STUDIO_ENV=production

# Render injects this from the sarthi-studio-db database. postgres:// URLs are accepted.
DATABASE_URL=

# S3-compatible bucket, private (no public access). Cloudflare R2 endpoint looks like
# https://<account-id>.r2.cloudflarestorage.com ; AWS S3 can leave the endpoint empty.
STUDIO_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
STUDIO_SCRATCH_DIR=/var/studio/scratch

# Sign-in with accounts created by the owner (python -m app.cli create-user).
STUDIO_AUTH_MODE=password
# Same value on the API and the worker; render.yaml generates it in the shared group.
STUDIO_SESSION_SECRET=
STUDIO_SESSION_TTL_HOURS=168
STUDIO_COOKIE_SECURE=true
# lax with the Vercel /api rewrite. none only if the browser calls the API origin directly.
STUDIO_COOKIE_SAMESITE=lax

STUDIO_JOB_RUNNER=queue
STUDIO_JOB_LEASE_SECONDS=180
STUDIO_SIGNED_URL_SECONDS=900
STUDIO_AUTO_MIGRATE=false
STUDIO_RATE_LIMIT_PER_MINUTE=600
STUDIO_LOGIN_ATTEMPTS=5
STUDIO_MAX_FILE_BYTES=524288000
STUDIO_MAX_SESSION_BYTES=2147483648

# The Vercel production origin, e.g. https://<project>.vercel.app (comma-separated if several).
STUDIO_CORS_ORIGINS=

# Worker only.
ELEVENLABS_API_KEY=
# Optional. Visual analysis uses Gemini only when this is set and STUDIO_VISUAL_PROVIDER allows it.
GEMINI_API_KEY=
STUDIO_VISUAL_PROVIDER=auto
STUDIO_ENGINE_PYTHON=/usr/local/bin/python
