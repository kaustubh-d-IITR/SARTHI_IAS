# Sarthi IAS Video Studio API, local development. Copy to api/.env if you want local overrides.
# This file is separate from the engine .env. Do not put speech or Gemini keys here.
# Production values go in the Render dashboard; see .env.production.example.

# development (default) or production. Production refuses to start without the safe settings.
STUDIO_ENV=development

# Empty means saarthi_video_engine/data/studio
STUDIO_DATA_DIR=

# Empty means SQLite at <data dir>/studio.db. Migrations run on start in development.
DATABASE_URL=
STUDIO_AUTO_MIGRATE=true

# local keeps files under the data dir. s3 uses the OBJECT_STORAGE_* settings below.
STUDIO_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
# Scratch space for jobs when storage is s3. Empty means <data dir>/scratch.
STUDIO_SCRATCH_DIR=

# client_header separates browsers without accounts (development only). password requires sign-in.
STUDIO_AUTH_MODE=client_header
# At least 32 random characters in password mode. Generate one locally; never commit it.
STUDIO_SESSION_SECRET=
STUDIO_SESSION_TTL_HOURS=168
STUDIO_COOKIE_SECURE=false
STUDIO_COOKIE_SAMESITE=lax

# inline runs jobs inside the API process. queue needs a separate `python -m app.worker`.
STUDIO_JOB_RUNNER=inline
STUDIO_JOB_LEASE_SECONDS=180
STUDIO_SIGNED_URL_SECONDS=900
STUDIO_RATE_LIMIT_PER_MINUTE=600
STUDIO_LOGIN_ATTEMPTS=5

# 512 MB per file. 2 GB across one prepared session.
STUDIO_MAX_FILE_BYTES=524288000
STUDIO_MAX_SESSION_BYTES=2147483648

STUDIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8787

# Visual analysis of My B-Roll clips: auto, clip, gemini (costs money), description, none.
STUDIO_VISUAL_PROVIDER=auto
# Interpreter with torch and the cached CLIP / Snowflake weights. Empty uses the project's Python 3.13.
STUDIO_ENGINE_PYTHON=
